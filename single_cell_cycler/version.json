  "release_notes": {
    "version": "1.2.3",
    "title": "v1.2.3 — High-Fidelity Characterization, Webhook Notifications & Packaging Stability",
    "date": "2026-09-30",
    "highlights": "Comprehensive integration of automated webhooks, full dQ/dV phase transition peak detection, resilient Windows build tooling with read-only permission recovery, and Inno Setup 6 installer distribution.",
    "changelog": {
      "features": [
        "Real-time webhook notification engine for test starts, cycle completions, emergency stops, and operator tagging",
        "Adaptive differential capacity (dQ/dV) peak extraction and phase transition characterization",
        "Configurable multi-chemistry guardrails (LFP, NMC, LTO, Na-Ion) with hardware setpoint handshakes",
        "Multi-format run exporter generating CSV streams, Excel summaries, and cryptographic manifest verification"
      ],
      "fixes": [
        "Resolved dQ/dV graph curve vanishing during dynamic real-time window rescale events",
        "Fixed V-Q and aging plot clipping on high-refresh-rate multi-monitor setups",
        "Fixed Windows WinError 5 access denied issues during PyInstaller clean and collect steps",
        "Aligned Inno Setup compiler parameterization with SingleCellBMSCycler binary naming"
      ],
      "security_and_resilience": [
        "Robust hardware e-stop timeout fail-safe with latching alarm states",
        "Automated sliding-window serial stream re-synchronization on physical disconnects"
      ]
    }
  }
