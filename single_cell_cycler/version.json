  "release_notes": {
    "version": "1.3.1",
    "title": "v1.3.1 — Configurable thermal protection",
    "date": "2026-10-07",
    "highlights": "Rate-of-rise thermal trip is now an operator switch (Safety tab) and ships OFF; all temperature limits are configurable in cycler_settings.json.",
    "changelog": {
      "features": [
        "Thermal Protection box on the BMS Safety tab: rate-of-rise trip on/off (confirmed, saved, locked during a test)",
        "\"safety\" section in cycler_settings.json: rate-of-rise switch, threshold, window, sustain, absolute and warning temperatures, clamped to safe bounds (max never above 80 C); applied at every START and on crash resume"
      ],
      "changes": [
        "Rate-of-rise (dT/dt) trip OFF by default; the absolute temperature limit and the BMS COT flag stay active"
      ],
      "test_infrastructure": [
        "Tests use a copy of cycler_settings.json; the run fails and restores the file if any test modifies the real one"
      ]
    }
  }
