{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build firmware",
            "type": "process",
            "command": "${config:bhfw.make}",
            "args": ["-j4"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash firmware (SWD)",
            "type": "process",
            "command": "${config:bhfw.make}",
            "args": ["flash"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Build firmware",
            "problemMatcher": []
        },
        {
            "label": "Clean firmware",
            "type": "process",
            "command": "${config:bhfw.make}",
            "args": ["clean"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Firmware size",
            "type": "process",
            "command": "${config:bhfw.make}",
            "args": ["size"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Ping board",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/../../tools/hil/run_hil.py", "--ping"],
            "problemMatcher": []
        }
    ]
}
