{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug NUCLEO-G474RE (ST-LINK)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/bh_sim.elf",
            "device": "STM32G474RE",
            "interface": "swd",
            "runToEntryPoint": "main",
            "preLaunchTask": "Build firmware",
            "svdFile": "C:/ST/STM32CubeIDE_2.2.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.productdb.debug_2.2.500.202605201745/resources/cmsis/STMicroelectronics_CMSIS_SVD/STM32G474.svd",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Attach to running NUCLEO-G474RE",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/bh_sim.elf",
            "device": "STM32G474RE",
            "interface": "swd",
            "svdFile": "C:/ST/STM32CubeIDE_2.2.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.productdb.debug_2.2.500.202605201745/resources/cmsis/STMicroelectronics_CMSIS_SVD/STM32G474.svd"
        }
    ]
}
